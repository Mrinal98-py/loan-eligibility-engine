# ==============================================================================
# Loan Eligibility Engine - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development. Never commit .env with real credentials.

# Execution Environment: local | test | production
ENVIRONMENT=local
LOG_LEVEL=INFO

# Application Database Configuration (PostgreSQL)
# Local: postgresql://mrinal@localhost:5432/loan_engine
# Docker: postgresql://loan_app_user:loan_app_password@postgres:5432/loan_engine
DATABASE_URL=postgresql://mrinal@localhost:5432/loan_engine
TEST_DATABASE_URL=postgresql://mrinal@localhost:5432/loan_engine_test

# AWS Configuration (Used by Lambda / Serverless & Local Mock Adapters)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock_access_key
AWS_SECRET_ACCESS_KEY=mock_secret_key
S3_BUCKET_NAME=loan-eligibility-uploads-local
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/loan-ingestion-queue
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789012/loan-ingestion-dlq

# Ingestion Constraints
MAX_FILE_SIZE_BYTES=104857600
PRESIGNED_URL_EXPIRATION_SECONDS=900

# Email Notification & Safety Settings (Amazon SES)
# CRITICAL: DELIVERY_MODE must be 'test' to prevent sending emails to sample CSV addresses.
DELIVERY_MODE=test
ALLOW_REAL_RECIPIENTS=false
TEST_EMAIL_RECIPIENTS=developer-test-inbox@example.com
SES_FROM_EMAIL=no-reply@verified-domain.com

# Webhook Security
# Shared secret required for Workflow B (matching) & Workflow C (notification) triggers
WEBHOOK_SECRET=replace-with-a-secure-random-64-char-token

# Workflow Orchestration URLs (n8n or local dispatcher)
N8N_MATCHING_WEBHOOK_URL=http://localhost:5678/webhook/user-loan-matching
N8N_NOTIFICATION_WEBHOOK_URL=http://localhost:5678/webhook/user-notification

# Optional LLM Integration for Unstructured Criteria Resolution
# Supported providers: mock | openai | gemini
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
